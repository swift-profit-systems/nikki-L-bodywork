---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Client Reviews | Nikki Leonardi Bodywork — 5.0 Stars, 22 Reviews" description="5.0 on Google. 22 reviews. Read what clients say about Nikki Leonardi Bodywork in Traverse City, MI.">
  <div class="pt-16">
    <section class="py-24 px-6 bg-[#162040] text-center">
      <div class="max-w-3xl mx-auto">
        <p class="section-label mb-6">Reviews</p>
        <h1 class="font-['Playfair_Display'] text-5xl text-[#f0f4ff] mb-4">5.0 Stars.</h1>
        <div class="text-[#c8a84b] text-3xl mb-3">★★★★★</div>
        <p class="text-[#c8a84b]/50 tracking-widest uppercase text-sm">22 Google Reviews</p>
      </div>
    </section>

    <!-- Anchor quote -->
    <section class="py-16 px-6 bg-[#0d1428]">
      <div class="max-w-4xl mx-auto text-center">
        <p class="font-['Playfair_Display'] text-2xl md:text-3xl text-[#f0f4ff] italic leading-relaxed mb-6">
          "I told my chiropractor about Nikki and she said 'I have to meet this Nikki — she has fixed 3 of my patients over the last year.' Nikki has made it so that those symptoms are gone 95 percent of the time for me."
        </p>
        <div class="gold-line mx-auto mb-3"></div>
        <p class="text-[#c8a84b]/40 text-xs tracking-widest uppercase">— Adam</p>
      </div>
    </section>

    <!-- Review grid -->
    <section class="py-20 px-6 bg-[#162040]">
      <div class="max-w-6xl mx-auto grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {[
          { quote: "BEST MASSAGE OF MY 63 YEARS! If deep tissue massage is your thing... you need to see her.", name: "Shelley Fox" },
          { quote: "Literally the best massage of my life and I've had plenty. The deepest most comfortable pressure ever.", name: "Matt Schram" },
          { quote: "It felt like years of pushups, chatarangas, burpees and mountain-climbers melted away.", name: "Barbara Sennrich" },
          { quote: "She worked my whole body, which most therapists don't. She was very intuitive the whole time. She is worth every dollar and a good tip.", name: "Sasha King, LMT" },
          { quote: "It has made a huge difference in my every day activity when seeing her on a regular basis.", name: "Michelle Mitchell" },
          { quote: "My favorite is the cupping — it really releases the sticky myofascial connective tissue and promotes healing. I have felt mass improvement after this procedure.", name: "Michelle Mitchell" },
          { quote: "I would venture to call it life changing.", name: "Charity" },
          { quote: "The only person I will go to for a massage.", name: "Maria Leggett-Guldner" },
          { quote: "She reads your body and responds intuitively to what it needs. Doesn't chit chat — just gets to work.", name: "Danielle Piotrowski" },
          { quote: "The ashiatsu modality feels like you have 2 people giving you a massage!", name: "Danielle Piotrowski" },
          { quote: "She is truly gifted at what she does.", name: "Danielle Piotrowski" },
          { quote: "She is very knowledgeable about the body and the muscle. I'm glad I opened up my mind and tried something different.", name: "Albert Patrick" },
        ].map(r => (
          <div class="border border-white/5 p-6 hover:border-[#c8a84b]/20 transition-colors">
            <p class="text-[#c8a84b] text-xs mb-4">★★★★★</p>
            <p class="text-[#f0f4ff]/80 text-sm leading-relaxed italic mb-5">"{r.quote}"</p>
            <div class="gold-line mb-2"></div>
            <p class="text-[#c8a84b]/40 text-xs tracking-widest uppercase">{r.name}</p>
          </div>
        ))}
      </div>
      <div class="text-center mt-14">
        <p class="text-[#c8a84b]/50 text-sm mb-6">Want to add your voice?</p>
        <a href="https://g.page/r/nikkileonardibodywork/review" target="_blank" rel="noopener" class="btn-outline">Leave a Google Review</a>
      </div>
    </section>

    <section class="py-16 px-6 bg-[#0d1428] text-center">
      <div class="max-w-xl mx-auto">
        <h2 class="font-['Playfair_Display'] text-3xl text-[#f0f4ff] mb-6">Ready to find out for yourself?</h2>
        <a href="/book" class="btn-primary">Book a Session</a>
      </div>
    </section>
  </div>
</Layout>
