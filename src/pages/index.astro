---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Nikki Leonardi Bodywork | Therapeutic Massage Traverse City MI"
  description="Therapeutic massage in Traverse City, MI. Ashiatsu barefoot massage, deep tissue, myofascial release. The deepest work in Northern Michigan."
  showStickyBook={true}
>

  <!-- HERO -->
  <section id="hero-section" class="relative min-h-screen flex items-center pt-16 overflow-hidden">
    <!-- Background image -->
    <div class="absolute inset-0 z-0">
      <img src="/images/studio.png" alt="Nikki Leonardi Bodywork studio" class="w-full h-full object-cover opacity-25" />
      <div class="absolute inset-0 bg-gradient-to-r from-[#162040] via-[#162040]/80 to-[#162040]/40"></div>
    </div>
    <div class="relative z-10 max-w-6xl mx-auto px-6 py-24">
      <div class="max-w-2xl">
        <p class="section-label mb-6">Traverse City, Michigan</p>
        <h1 class="font-['Playfair_Display'] text-5xl md:text-7xl text-[#f0f4ff] leading-[1.05] mb-6">
          The deepest<br/>
          <em class="text-[#c8a84b]">work</em> in<br/>
          Traverse City.
        </h1>
        <!-- HEADLINE VARIANT A: "You've been told 'that's as deep as I can go' for the last time." -->
        <!-- HEADLINE VARIANT B: "The massage your chiropractor wishes existed." -->
        <p class="text-[rgba(240,244,255,0.75)] text-base md:text-lg leading-relaxed mb-10 max-w-xl font-['Inter'] font-light">
          If you've spent years asking for deeper and never finding it, stop looking.
        </p>
        <div class="flex flex-wrap gap-4 mb-16">
          <a href="/book" class="btn-primary">Book a Session</a>
          <a href="/about" class="text-[#c8a84b]/70 hover:text-[#c8a84b] text-xs tracking-widest uppercase border-b border-[#c8a84b]/30 hover:border-[#c8a84b]/70 pb-0.5 self-center transition-colors">Meet Nikki</a>
        </div>
        <!-- Credibility bar -->
        <div class="flex flex-wrap gap-8 border-t border-white/10 pt-8">
          <div>
            <p class="font-['Playfair_Display'] text-3xl text-[#c8a84b]">5.0</p>
            <p class="text-[#c8a84b]/50 text-xs tracking-widest uppercase mt-1">Google Stars</p>
          </div>
          <div class="w-px bg-white/10 self-stretch"></div>
          <div>
            <p class="font-['Playfair_Display'] text-3xl text-[#c8a84b]">22</p>
            <p class="text-[#c8a84b]/50 text-xs tracking-widest uppercase mt-1">Reviews</p>
          </div>
          <div class="w-px bg-white/10 self-stretch"></div>
          <div>
            <p class="font-['Playfair_Display'] text-3xl text-[#c8a84b]">13+</p>
            <p class="text-[#c8a84b]/50 text-xs tracking-widest uppercase mt-1">Years Practice</p>
          </div>
          <div class="w-px bg-white/10 self-stretch"></div>
          <div>
            <p class="font-['Playfair_Display'] text-3xl text-[#c8a84b]">1 of few</p>
            <p class="text-[#c8a84b]/50 text-xs tracking-widest uppercase mt-1">Ashiatsu in N. Michigan</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CHIROPRACTOR QUOTE — conversion anchor -->
  <section class="bg-[#0d1428] py-20 px-6">
    <div class="max-w-4xl mx-auto text-center">
      <p class="font-['Playfair_Display'] text-2xl md:text-4xl text-[#f0f4ff] leading-relaxed italic mb-8">
        "My chiropractor asked who finally fixed my back. When I told her, she said, 'I need to send more patients to Nikki.'"
      </p>
      <div class="gold-line"></div>
      <p class="text-[#c8a84b]/60 text-sm tracking-widest uppercase mt-4">— Adam, Google Review</p>
    </div>
  </section>

  <!-- ASHIATSU IN ACTION — hero photos -->
  <section class="py-20 px-6 bg-[#162040]">
    <div class="max-w-6xl mx-auto">
      <div class="grid md:grid-cols-2 gap-6 items-center">
        <div>
          <p class="section-label mb-4">Why people drive an hour for this.</p>
          <h2 class="font-['Playfair_Display'] text-4xl md:text-5xl text-[#f0f4ff] mb-6 leading-tight">
            Barefoot massage.<br/><em class="text-[#c8a84b]">Like two people<br/>working on you.</em>
          </h2>
          <p class="text-[#c8a84b]/70 leading-relaxed mb-6">
            Ashiatsu is massage performed with the feet — supported by overhead bars — delivering sustained, consistent pressure that hands simply cannot replicate. If you've spent years asking for deeper and never finding it, this is what you've been looking for.
          </p>
          <p class="text-[#c8a84b]/50 text-sm leading-relaxed mb-8 italic">
            "The deepest most comfortable pressure ever. 1st time doing this type of massage and I can't wait for my next one." — Matt Schram
          </p>
          <a href="/tools" class="btn-primary">Learn About Ashiatsu</a>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <img src="/images/ashiatsu-1.png" alt="Ashiatsu barefoot massage in practice" class="w-full h-64 object-cover object-top" />
          <img src="/images/ashiatsu-2.png" alt="Ashiatsu deep tissue barefoot work" class="w-full h-64 object-cover object-top mt-6" />
          <img src="/images/ashiatsu-3.png" alt="Nikki Leonardi barefoot massage technique" class="w-full h-64 object-cover col-span-2" />
        </div>
      </div>
    </div>
  </section>

  <!-- THREE DIFFERENTIATORS -->
  <section class="py-20 px-6 bg-[#0d1428]">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-14">
        <p class="section-label mb-4">What Makes This Different</p>
        <h2 class="font-['Playfair_Display'] text-4xl text-[#f0f4ff]">Most massage treats where it hurts.<br/><em class="text-[#c8a84b]">Nikki finds out why.</em></h2>
      </div>
      <div class="grid md:grid-cols-3 gap-8">
        <!-- Card 1 -->
        <div class="border border-white/10 p-8 hover:border-[#c8a84b]/30 transition-colors">
          <div class="gold-line mb-6"></div>
          <h3 class="font-['Playfair_Display'] text-xl text-[#f0f4ff] mb-4">She reads the body, not just the complaint</h3>
          <p class="text-[#c8a84b]/60 text-sm leading-relaxed mb-5">
            Every session is a diagnostic conversation. Nikki looks for the fascial restriction, the structural imbalance, the compensatory pattern — not just the place that hurts.
          </p>
          <p class="text-[#c8a84b]/40 text-sm italic">"She reads your body and responds intuitively to what it needs. Doesn't chit chat — just gets to work." — Danielle P.</p>
        </div>
        <!-- Card 2 -->
        <div class="border border-white/10 p-8 hover:border-[#c8a84b]/30 transition-colors">
          <div class="gold-line mb-6"></div>
          <h3 class="font-['Playfair_Display'] text-xl text-[#f0f4ff] mb-4">The deepest pressure you've ever felt</h3>
          <p class="text-[#c8a84b]/60 text-sm leading-relaxed mb-5">
            Ashiatsu barefoot massage delivers sustained, consistent pressure that hands cannot replicate. If you've never been able to find "deep enough" — this is what you've been looking for.
          </p>
          <p class="text-[#c8a84b]/40 text-sm italic">"The ashiatsu modality feels like you have 2 people giving you a massage!" — Danielle P.</p>
        </div>
        <!-- Card 3 -->
        <div class="border border-white/10 p-8 hover:border-[#c8a84b]/30 transition-colors">
          <div class="gold-line mb-6"></div>
          <h3 class="font-['Playfair_Display'] text-xl text-[#f0f4ff] mb-4">Results that last</h3>
          <p class="text-[#c8a84b]/60 text-sm leading-relaxed mb-5">
            The goal is not to feel better until next week. Nikki sends every client home with customized stretches and exercises to support and extend the work done in session.
          </p>
          <p class="text-[#c8a84b]/40 text-sm italic">"Nikki has made it so that those symptoms are gone 95% of the time for me." — Adam</p>
        </div>
      </div>
    </div>
  </section>

  <!-- SESSION MENU -->
  <section class="py-24 px-6 bg-[#1e2d52]">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-4">
        <p class="section-label mb-4">Book a Session</p>
        <h2 class="font-['Playfair_Display'] text-4xl text-[#f0f4ff]">You pick the time.<br/><em class="text-[#c8a84b]">Nikki handles everything else.</em></h2>
        <p class="text-[#c8a84b]/50 text-sm mt-4 max-w-lg mx-auto">Every session is fully integrative. Nikki reads what your body needs and draws from her full toolkit — Ashiatsu, myofascial, cupping, gua sha — accordingly. You show up. She takes it from there.</p>
        <a href="/tools" class="inline-block mt-4 text-[#c8a84b]/60 hover:text-[#c8a84b] text-xs tracking-widest uppercase transition-colors border-b border-[#c8a84b]/20 hover:border-[#c8a84b]/60 pb-0.5">Learn more about the tools →</a>
      </div>

      <!-- Divider -->
      <div class="my-10 border-t border-white/10"></div>

      <!-- 120 min — hero product, TOP -->
      <a href="/book" class="block mb-3 group">
        <div class="relative bg-[#162040] border border-[#c8a84b]/40 hover:border-[#c8a84b]/80 transition-colors p-7 md:p-9">
          <!-- Gold accent bar -->
          <div class="absolute top-0 left-0 w-1 h-full bg-[#c8a84b]"></div>
          <div class="pl-4">
            <div class="flex flex-wrap items-center gap-3 mb-2">
              <p class="font-['Playfair_Display'] text-2xl md:text-3xl text-[#f0f4ff] group-hover:text-[#c8a84b] transition-colors">120 min Customized Session</p>
              <span class="section-label text-[#c8a84b] bg-[#c8a84b]/15 border border-[#c8a84b]/30 px-3 py-1">Most Popular</span>
            </div>
            <p class="text-[#c8a84b]/70 text-sm leading-relaxed max-w-xl mb-5">Full-body work without compromise. The session where Ashiatsu shines — enough time to work top to bottom, address the root pattern, and not rush a single piece of it.</p>
            <div class="flex items-center justify-between flex-wrap gap-4">
              <p class="font-['Playfair_Display'] text-4xl text-[#c8a84b]">$200</p>
              <span class="text-[#c8a84b] text-xs tracking-widest uppercase border border-[#c8a84b]/40 px-4 py-2 group-hover:bg-[#c8a84b]/10 transition-colors">Book This Session →</span>
            </div>
          </div>
        </div>
      </a>

      <!-- First-visit reassurance — below 120 min card -->
      <div class="mb-3 px-5 py-4 bg-[#162040]/50 border border-white/5">
        <p class="text-[#c8a84b]/60 text-xs leading-relaxed font-['Inter']">
          First time trying Ashiatsu? Nikki checks in early in the session to dial the pressure to exactly where you want it. Every session is tailored to what your body needs that day.
        </p>
      </div>

      <!-- Remaining sessions -->
      <div class="space-y-px bg-white/5 mb-3">
        <!-- 90 min -->
        <a href="/book" class="block group">
          <div class="bg-[#1e2d52] p-6 md:p-7 flex items-center justify-between hover:bg-[#243460] transition-colors">
            <div>
              <p class="font-['Playfair_Display'] text-lg text-[#f0f4ff] group-hover:text-[#c8a84b] transition-colors">90 min Customized Session</p>
              <p class="text-[#c8a84b]/50 text-sm mt-1">Recommended starting point. Enough time to assess and address the full pattern.</p>
            </div>
            <div class="text-right ml-8 shrink-0">
              <p class="font-['Playfair_Display'] text-2xl text-[#c8a84b]">$150</p>
              <p class="text-[#c8a84b]/40 text-xs mt-1 tracking-widest uppercase">Book →</p>
            </div>
          </div>
        </a>
        <!-- 75 min -->
        <a href="/book" class="block group">
          <div class="bg-[#1e2d52] p-6 md:p-7 flex items-center justify-between hover:bg-[#243460] transition-colors">
            <div>
              <p class="font-['Playfair_Display'] text-lg text-[#f0f4ff] group-hover:text-[#c8a84b] transition-colors">75 min Customized Session</p>
              <p class="text-[#c8a84b]/50 text-sm mt-1">Primary area plus surrounding patterns. Good for targeted recovery.</p>
            </div>
            <div class="text-right ml-8 shrink-0">
              <p class="font-['Playfair_Display'] text-2xl text-[#c8a84b]">$125</p>
              <p class="text-[#c8a84b]/40 text-xs mt-1 tracking-widest uppercase">Book →</p>
            </div>
          </div>
        </a>
        <!-- 60 min -->
        <a href="/book" class="block group">
          <div class="bg-[#1e2d52] p-6 md:p-7 flex items-center justify-between hover:bg-[#243460] transition-colors">
            <div>
              <p class="font-['Playfair_Display'] text-lg text-[#f0f4ff] group-hover:text-[#c8a84b] transition-colors">60 min Customized Session</p>
              <p class="text-[#c8a84b]/50 text-sm mt-1">Focused work on a specific area or maintenance between longer sessions.</p>
            </div>
            <div class="text-right ml-8 shrink-0">
              <p class="font-['Playfair_Display'] text-2xl text-[#c8a84b]">$100</p>
              <p class="text-[#c8a84b]/40 text-xs mt-1 tracking-widest uppercase">Book →</p>
            </div>
          </div>
        </a>
      </div>

      <!-- Prenatal — separate subsection -->
      <div class="mt-10 border-t border-white/10 pt-10">
        <p class="section-label mb-5">Prenatal Massage</p>
        <div class="space-y-px bg-white/5">
          <a href="/book" class="block group">
            <div class="bg-[#1e2d52] p-6 flex items-center justify-between hover:bg-[#243460] transition-colors">
              <div>
                <p class="text-[#f0f4ff] group-hover:text-[#c8a84b] transition-colors">60 min Prenatal</p>
                <p class="text-[#c8a84b]/40 text-xs mt-1">All products safe for mother and baby</p>
              </div>
              <div class="text-right ml-8 shrink-0">
                <p class="font-['Playfair_Display'] text-xl text-[#c8a84b]">$100</p>
                <p class="text-[#c8a84b]/40 text-xs mt-1 tracking-widest uppercase">Book →</p>
              </div>
            </div>
          </a>
          <a href="/book" class="block group">
            <div class="bg-[#1e2d52] p-6 flex items-center justify-between hover:bg-[#243460] transition-colors">
              <div>
                <p class="text-[#f0f4ff] group-hover:text-[#c8a84b] transition-colors">75 min Prenatal</p>
                <p class="text-[#c8a84b]/40 text-xs mt-1">All products safe for mother and baby</p>
              </div>
              <div class="text-right ml-8 shrink-0">
                <p class="font-['Playfair_Display'] text-xl text-[#c8a84b]">$125</p>
                <p class="text-[#c8a84b]/40 text-xs mt-1 tracking-widest uppercase">Book →</p>
              </div>
            </div>
          </a>
          <a href="/book" class="block group">
            <div class="bg-[#1e2d52] p-6 flex items-center justify-between hover:bg-[#243460] transition-colors">
              <div>
                <p class="text-[#f0f4ff] group-hover:text-[#c8a84b] transition-colors">90 min Prenatal</p>
                <p class="text-[#c8a84b]/40 text-xs mt-1">All products safe for mother and baby</p>
              </div>
              <div class="text-right ml-8 shrink-0">
                <p class="font-['Playfair_Display'] text-xl text-[#c8a84b]">$150</p>
                <p class="text-[#c8a84b]/40 text-xs mt-1 tracking-widest uppercase">Book →</p>
              </div>
            </div>
          </a>
        </div>
      </div>

      <!-- Add-ons -->
      <div class="mt-10 border-t border-white/10 pt-10">
        <p class="section-label mb-5">Add-Ons</p>
        <div class="bg-white/5">
          <div class="bg-[#1e2d52] p-6 flex items-center justify-between">
            <div>
              <p class="text-[#f0f4ff]">CBD-Infused Massage Oil</p>
              <p class="text-[#c8a84b]/50 text-sm mt-1">Deep absorption, reduced inflammation. Add to any session.</p>
            </div>
            <div class="text-right ml-8 shrink-0">
              <p class="font-['Playfair_Display'] text-xl text-[#c8a84b]">+$10</p>
            </div>
          </div>
        </div>
      </div>

      <div class="text-center mt-12">
        <a href="/book" class="btn-primary">Book a Session</a>
      </div>
    </div>
  </section>

  <!-- REVIEW WALL -->
  <section class="py-20 px-6 bg-[#0d1428]">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-14">
        <p class="section-label mb-4">What Clients Say</p>
        <div class="flex items-center justify-center gap-2 mb-2">
          <span class="text-[#c8a84b] text-xl">★★★★★</span>
        </div>
        <p class="text-[#c8a84b]/40 text-sm tracking-widest uppercase">5.0 — 22 Google Reviews</p>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {[
          { quote: "BEST MASSAGE OF MY 63 YEARS! If deep tissue massage is your thing... you need to see her.", name: "Shelley Fox" },
          { quote: "Literally the best massage of my life and I've had plenty. The deepest most comfortable pressure ever.", name: "Matt Schram" },
          { quote: "It felt like years of pushups, chatarangas, burpees and mountain-climbers melted away.", name: "Barbara Sennrich" },
          { quote: "She worked my whole body, which most therapists don't. She was very intuitive the whole time. She is worth every dollar and a good tip.", name: "Sasha King, LMT" },
          { quote: "It has made a huge difference in my every day activity when seeing her on a regular basis.", name: "Michelle Mitchell" },
          { quote: "I would venture to call it life changing.", name: "Charity" },
        ].map(r => (
          <div class="border border-white/5 p-6 hover:border-[#c8a84b]/20 transition-colors">
            <p class="text-[#c8a84b] text-xs mb-4">★★★★★</p>
            <p class="text-[#f0f4ff]/80 text-sm leading-relaxed italic mb-5">"{r.quote}"</p>
            <div class="gold-line mb-2"></div>
            <p class="text-[#c8a84b]/50 text-xs tracking-widest uppercase">{r.name}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CLOSING CTA -->
  <section class="py-24 px-6 bg-[#162040] text-center">
    <div class="max-w-2xl mx-auto">
      <p class="section-label mb-6">Ready?</p>
      <h2 class="font-['Playfair_Display'] text-4xl md:text-5xl text-[#f0f4ff] mb-6 leading-tight">
        If you're ready for a different kind of work —<br/>
        <em class="text-[#c8a84b]">I'm ready when you are.</em>
      </h2>
      <p class="text-[#c8a84b]/60 mb-10">10691 E Carter Rd, Traverse City, MI · Online booking</p>
      <a href="/book" class="btn-primary text-base px-12 py-4">Book Your Session</a>
    </div>
  </section>

</Layout>
