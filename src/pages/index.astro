---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Nikki Leonardi Bodywork | Therapeutic Massage Traverse City MI" description="Ashiatsu specialist. 13 years of practice. 5.0 on Google. The therapist your chiropractor's patients get sent to. Traverse City, MI.">

  <!-- HERO -->
  <section class="relative min-h-screen flex items-center pt-16 overflow-hidden">
    <!-- Background image -->
    <div class="absolute inset-0 z-0">
      <img src="/images/studio.png" alt="Nikki Leonardi Bodywork studio" class="w-full h-full object-cover opacity-25" />
      <div class="absolute inset-0 bg-gradient-to-r from-[#1a1714] via-[#1a1714]/80 to-[#1a1714]/40"></div>
    </div>
    <div class="relative z-10 max-w-6xl mx-auto px-6 py-24">
      <div class="max-w-2xl">
        <p class="section-label mb-6">Traverse City, Michigan</p>
        <h1 class="font-['Playfair_Display'] text-5xl md:text-7xl text-[#f5f0e8] leading-[1.05] mb-6">
          The deepest<br/>
          <em class="text-[#c4a882]">work</em> in<br/>
          Traverse City.
        </h1>
        <p class="text-[#c4a882]/70 text-lg md:text-xl leading-relaxed mb-10 max-w-xl">
          Ashiatsu specialist. 13 years of practice. 5.0 on Google.<br/>
          The therapist your chiropractor's patients get sent to.
        </p>
        <div class="flex flex-wrap gap-4 mb-16">
          <a href="/book" class="btn-primary">Book a Session</a>
          <a href="/about" class="btn-outline">Meet Nikki</a>
        </div>
        <!-- Credibility bar -->
        <div class="flex flex-wrap gap-8 border-t border-white/10 pt-8">
          <div>
            <p class="font-['Playfair_Display'] text-3xl text-[#c4a882]">5.0</p>
            <p class="text-[#c4a882]/50 text-xs tracking-widest uppercase mt-1">Google Stars</p>
          </div>
          <div class="w-px bg-white/10 self-stretch"></div>
          <div>
            <p class="font-['Playfair_Display'] text-3xl text-[#c4a882]">22</p>
            <p class="text-[#c4a882]/50 text-xs tracking-widest uppercase mt-1">Reviews</p>
          </div>
          <div class="w-px bg-white/10 self-stretch"></div>
          <div>
            <p class="font-['Playfair_Display'] text-3xl text-[#c4a882]">13+</p>
            <p class="text-[#c4a882]/50 text-xs tracking-widest uppercase mt-1">Years Practice</p>
          </div>
          <div class="w-px bg-white/10 self-stretch"></div>
          <div>
            <p class="font-['Playfair_Display'] text-3xl text-[#c4a882]">1 of few</p>
            <p class="text-[#c4a882]/50 text-xs tracking-widest uppercase mt-1">Ashiatsu in N. Michigan</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CHIROPRACTOR QUOTE — conversion anchor -->
  <section class="bg-[#100e0c] py-20 px-6">
    <div class="max-w-4xl mx-auto text-center">
      <p class="font-['Playfair_Display'] text-2xl md:text-4xl text-[#f5f0e8] leading-relaxed italic mb-8">
        "I told my chiropractor about Nikki and she said 'I have to meet this Nikki — she has fixed 3 of my patients over the last year.'"
      </p>
      <div class="gold-line"></div>
      <p class="text-[#c4a882]/60 text-sm tracking-widest uppercase mt-4">— Adam, Google Review</p>
    </div>
  </section>

  <!-- ASHIATSU IN ACTION — hero photos -->
  <section class="py-20 px-6 bg-[#1a1714]">
    <div class="max-w-6xl mx-auto">
      <div class="grid md:grid-cols-2 gap-6 items-center">
        <div>
          <p class="section-label mb-4">What You'll Feel</p>
          <h2 class="font-['Playfair_Display'] text-4xl md:text-5xl text-[#f5f0e8] mb-6 leading-tight">
            Barefoot massage.<br/><em class="text-[#c4a882]">Like two people<br/>working on you.</em>
          </h2>
          <p class="text-[#c4a882]/70 leading-relaxed mb-6">
            Ashiatsu is massage performed with the feet — supported by overhead bars — delivering sustained, consistent pressure that hands simply cannot replicate. If you've spent years asking for deeper and never finding it, this is what you've been looking for.
          </p>
          <p class="text-[#c4a882]/50 text-sm leading-relaxed mb-8 italic">
            "The deepest most comfortable pressure ever. 1st time doing this type of massage and I can't wait for my next one." — Matt Schram
          </p>
          <a href="/services/ashiatsu" class="btn-primary">Learn About Ashiatsu</a>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <img src="/images/ashiatsu-1.png" alt="Ashiatsu barefoot massage in practice" class="w-full h-64 object-cover object-top" />
          <img src="/images/ashiatsu-2.png" alt="Ashiatsu deep tissue barefoot work" class="w-full h-64 object-cover object-top mt-6" />
          <img src="/images/ashiatsu-3.png" alt="Nikki Leonardi barefoot massage technique" class="w-full h-64 object-cover col-span-2" />
        </div>
      </div>
    </div>
  </section>

  <!-- THREE DIFFERENTIATORS -->
  <section class="py-20 px-6 bg-[#100e0c]">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-14">
        <p class="section-label mb-4">What Makes This Different</p>
        <h2 class="font-['Playfair_Display'] text-4xl text-[#f5f0e8]">Most massage treats where it hurts.<br/><em class="text-[#c4a882]">Nikki finds out why.</em></h2>
      </div>
      <div class="grid md:grid-cols-3 gap-8">
        <!-- Card 1 -->
        <div class="border border-white/10 p-8 hover:border-[#c4a882]/30 transition-colors">
          <div class="gold-line mb-6"></div>
          <h3 class="font-['Playfair_Display'] text-xl text-[#f5f0e8] mb-4">She reads the body, not just the complaint</h3>
          <p class="text-[#c4a882]/60 text-sm leading-relaxed mb-5">
            Every session is a diagnostic conversation. Nikki looks for the fascial restriction, the structural imbalance, the compensatory pattern — not just the place that hurts.
          </p>
          <p class="text-[#c4a882]/40 text-sm italic">"She reads your body and responds intuitively to what it needs. Doesn't chit chat — just gets to work." — Danielle P.</p>
        </div>
        <!-- Card 2 -->
        <div class="border border-white/10 p-8 hover:border-[#c4a882]/30 transition-colors">
          <div class="gold-line mb-6"></div>
          <h3 class="font-['Playfair_Display'] text-xl text-[#f5f0e8] mb-4">The deepest pressure you've ever felt</h3>
          <p class="text-[#c4a882]/60 text-sm leading-relaxed mb-5">
            Ashiatsu barefoot massage delivers sustained, consistent pressure that hands cannot replicate. If you've never been able to find "deep enough" — this is what you've been looking for.
          </p>
          <p class="text-[#c4a882]/40 text-sm italic">"The ashiatsu modality feels like you have 2 people giving you a massage!" — Danielle P.</p>
        </div>
        <!-- Card 3 -->
        <div class="border border-white/10 p-8 hover:border-[#c4a882]/30 transition-colors">
          <div class="gold-line mb-6"></div>
          <h3 class="font-['Playfair_Display'] text-xl text-[#f5f0e8] mb-4">Results that last</h3>
          <p class="text-[#c4a882]/60 text-sm leading-relaxed mb-5">
            The goal is not to feel better until next week. Nikki sends every client home with customized stretches and exercises to support and extend the work done in session.
          </p>
          <p class="text-[#c4a882]/40 text-sm italic">"Nikki has made it so that those symptoms are gone 95% of the time for me." — Adam</p>
        </div>
      </div>
    </div>
  </section>

  <!-- SERVICES PREVIEW -->
  <section class="py-20 px-6 bg-[#1a1714]">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-14">
        <p class="section-label mb-4">Services</p>
        <h2 class="font-['Playfair_Display'] text-4xl text-[#f5f0e8]">Every session is integrative.<br/><em class="text-[#c4a882]">The modality follows the body.</em></h2>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-px bg-white/5">
        {[
          { name: 'Ashiatsu (Barefoot) Massage', desc: 'The lead service. Barefoot pressure that reaches where hands stop. One of very few practitioners in Northern Michigan.', href: '/services/ashiatsu', tag: 'Signature' },
          { name: 'Deep Tissue Massage', desc: 'Targeted work for chronic tension and overuse patterns. 13 years of knowing the difference between pressure and effective pressure.', href: '/services/deep-tissue', tag: null },
          { name: 'Myofascial Release', desc: 'For the tension you can feel but can\'t quite touch. Slow, specific work that unlocks what nothing else has reached.', href: '/services/myofascial', tag: null },
          { name: 'Cupping Therapy', desc: 'Lift instead of compress. Suction draws circulation into restricted areas and creates space that pressure alone cannot.', href: '/services/cupping', tag: null },
          { name: 'Gua Sha', desc: 'Instrument-assisted fascial release that breaks down adhesions and restores tissue mobility.', href: '/services/gua-sha', tag: null },
          { name: 'Prenatal Massage', desc: 'Therapeutic, safe, and supportive work for mothers-to-be. All products free of ingredients that could put you or your baby at risk.', href: '/services/prenatal', tag: null },
        ].map(s => (
          <a href={s.href} class="bg-[#1a1714] p-8 hover:bg-[#2c2318] transition-colors group block">
            {s.tag && <span class="section-label text-[#c4a882] text-xs mb-3 block">{s.tag}</span>}
            <h3 class="font-['Playfair_Display'] text-lg text-[#f5f0e8] mb-3 group-hover:text-[#c4a882] transition-colors">{s.name}</h3>
            <p class="text-[#c4a882]/50 text-sm leading-relaxed">{s.desc}</p>
            <p class="text-[#c4a882] text-xs tracking-widest uppercase mt-5">Learn more →</p>
          </a>
        ))}
      </div>
      <div class="text-center mt-10">
        <a href="/book" class="btn-primary">Book a Session</a>
      </div>
    </div>
  </section>

  <!-- PREMIUM OFFER — The Body Blueprint -->
  <section class="py-24 px-6 bg-[#2c2318]">
    <div class="max-w-4xl mx-auto">
      <div class="text-center mb-12">
        <p class="section-label mb-4">Premium Experience</p>
        <h2 class="font-['Playfair_Display'] text-4xl md:text-5xl text-[#f5f0e8] mb-6">The Body Blueprint Session™</h2>
        <p class="text-[#c4a882]/70 text-lg leading-relaxed max-w-2xl mx-auto">
          For clients who want more than a great session — they want to understand what's actually happening in their body and leave with a real plan.
        </p>
      </div>
      <div class="border border-[#c4a882]/30 p-10 md:p-14">
        <div class="grid md:grid-cols-2 gap-10">
          <div>
            <p class="section-label mb-5">What's Included</p>
            <ul class="space-y-4">
              {[
                '20-min intake assessment — goals, patterns, history, what your body is actually doing',
                '90-min integrative treatment — Ashiatsu + myofascial + whatever your body needs that session',
                'Written Body Map delivered within 24 hours — fascial patterns identified, compensatory habits noted',
                '3–5 custom home care exercises with video links specific to your body',
                'Priority booking for follow-up sessions',
              ].map(item => (
                <li class="flex gap-3 text-sm text-[#c4a882]/70 leading-relaxed">
                  <span class="text-[#c4a882] mt-0.5 shrink-0">—</span>
                  {item}
                </li>
              ))}
            </ul>
          </div>
          <div class="flex flex-col justify-between">
            <div>
              <p class="section-label mb-3">Investment</p>
              <p class="font-['Playfair_Display'] text-5xl text-[#c4a882] mb-2">$295</p>
              <p class="text-[#c4a882]/40 text-sm mb-8">vs. standard 90-min session at $150</p>
              <p class="text-[#c4a882]/60 text-sm leading-relaxed italic mb-8">
                "This is for the person who has been managing their body for years and is ready to actually understand it."
              </p>
            </div>
            <a href="/book" class="btn-primary block text-center">Book a Body Blueprint Session</a>
          </div>
        </div>
      </div>

      <!-- Packages & Gift Cards row -->
      <div class="grid md:grid-cols-3 gap-6 mt-8">
        <div class="border border-white/10 p-6 hover:border-[#c4a882]/30 transition-colors">
          <p class="section-label mb-3">Session Packages</p>
          <h3 class="font-['Playfair_Display'] text-lg text-[#f5f0e8] mb-2">Commit. Save. Progress.</h3>
          <p class="text-[#c4a882]/50 text-sm leading-relaxed mb-5">3-pack or 5-pack prepaid sessions at a preferred rate. Best for clients working through a pattern or in active training.</p>
          <a href="/book" class="text-[#c4a882] text-xs tracking-widest uppercase hover:text-[#d4bc9a]">View Packages →</a>
        </div>
        <div class="border border-white/10 p-6 hover:border-[#c4a882]/30 transition-colors">
          <p class="section-label mb-3">Gift Cards</p>
          <h3 class="font-['Playfair_Display'] text-lg text-[#f5f0e8] mb-2">Give the work.</h3>
          <p class="text-[#c4a882]/50 text-sm leading-relaxed mb-5">Gift cards available for any session type or dollar amount. The kind of gift people actually use.</p>
          <a href="/book" class="text-[#c4a882] text-xs tracking-widest uppercase hover:text-[#d4bc9a]">Buy a Gift Card →</a>
        </div>
        <div class="border border-white/10 p-6 hover:border-[#c4a882]/30 transition-colors">
          <p class="section-label mb-3">Monthly Membership</p>
          <h3 class="font-['Playfair_Display'] text-lg text-[#f5f0e8] mb-2">Stay ahead of it.</h3>
          <p class="text-[#c4a882]/50 text-sm leading-relaxed mb-5">One 90-min session per month + priority booking. For clients who treat bodywork as maintenance, not emergency response.</p>
          <a href="/book" class="text-[#c4a882] text-xs tracking-widest uppercase hover:text-[#d4bc9a]">Learn More →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- WHO I WORK WITH teaser -->
  <section class="py-20 px-6 bg-[#1a1714]">
    <div class="max-w-6xl mx-auto grid md:grid-cols-2 gap-px bg-white/5">
      <a href="/work-with-me#athletes" class="bg-[#1a1714] p-10 hover:bg-[#2c2318] transition-colors group">
        <p class="section-label mb-4">For Athletes & Active People</p>
        <h3 class="font-['Playfair_Display'] text-2xl text-[#f5f0e8] mb-4 group-hover:text-[#c4a882] transition-colors">For people who use their body hard and need it to work.</h3>
        <p class="text-[#c4a882]/50 text-sm leading-relaxed mb-6">Trail runners. Cyclists. Gym athletes. Yoga practitioners. The work I do isn't recovery in the spa sense — it's understanding what your training is doing to your tissue.</p>
        <p class="text-[#c4a882] text-xs tracking-widest uppercase">Learn More →</p>
      </a>
      <a href="/work-with-me#chronic-pain" class="bg-[#1a1714] p-10 hover:bg-[#2c2318] transition-colors group">
        <p class="section-label mb-4">For Chronic Pain & Recovery</p>
        <h3 class="font-['Playfair_Display'] text-2xl text-[#f5f0e8] mb-4 group-hover:text-[#c4a882] transition-colors">For people who have tried everything else and are tired of managing it.</h3>
        <p class="text-[#c4a882]/50 text-sm leading-relaxed mb-6">You know the pattern. Something hurts. You stretch it, ice it, see the chiropractor. It gets better for a while. Then you're back. The reason it keeps coming back is usually that the root cause hasn't been found yet.</p>
        <p class="text-[#c4a882] text-xs tracking-widest uppercase">Learn More →</p>
      </a>
    </div>
  </section>

  <!-- REVIEW WALL -->
  <section class="py-20 px-6 bg-[#100e0c]">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-14">
        <p class="section-label mb-4">What Clients Say</p>
        <div class="flex items-center justify-center gap-2 mb-2">
          <span class="text-[#c4a882] text-xl">★★★★★</span>
        </div>
        <p class="text-[#c4a882]/40 text-sm tracking-widest uppercase">5.0 — 22 Google Reviews</p>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {[
          { quote: "BEST MASSAGE OF MY 63 YEARS! If deep tissue massage is your thing... you need to see her.", name: "Shelley Fox" },
          { quote: "Literally the best massage of my life and I've had plenty. The deepest most comfortable pressure ever.", name: "Matt Schram" },
          { quote: "It felt like years of pushups, chatarangas, burpees and mountain-climbers melted away.", name: "Barbara Sennrich" },
          { quote: "She worked my whole body, which most therapists don't. She was very intuitive the whole time. She is worth every dollar and a good tip.", name: "Sasha King, LMT" },
          { quote: "It has made a huge difference in my every day activity when seeing her on a regular basis.", name: "Michelle Mitchell" },
          { quote: "I would venture to call it life changing.", name: "Charity" },
        ].map(r => (
          <div class="border border-white/5 p-6 hover:border-[#c4a882]/20 transition-colors">
            <p class="text-[#c4a882] text-xs mb-4">★★★★★</p>
            <p class="text-[#f5f0e8]/80 text-sm leading-relaxed italic mb-5">"{r.quote}"</p>
            <div class="gold-line mb-2"></div>
            <p class="text-[#c4a882]/50 text-xs tracking-widest uppercase">{r.name}</p>
          </div>
        ))}
      </div>
      <div class="text-center mt-10">
        <a href="/reviews" class="btn-outline">See All Reviews</a>
      </div>
    </div>
  </section>

  <!-- CLOSING CTA -->
  <section class="py-24 px-6 bg-[#1a1714] text-center">
    <div class="max-w-2xl mx-auto">
      <p class="section-label mb-6">Ready?</p>
      <h2 class="font-['Playfair_Display'] text-4xl md:text-5xl text-[#f5f0e8] mb-6 leading-tight">
        If you're ready for a different kind of work —<br/>
        <em class="text-[#c4a882]">I'm ready when you are.</em>
      </h2>
      <p class="text-[#c4a882]/60 mb-10">10691 E Carter Rd, Traverse City, MI · Online booking</p>
      <a href="/book" class="btn-primary text-base px-12 py-4">Book Your Session</a>
    </div>
  </section>

</Layout>
