---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Book a Session | Nikki Leonardi Bodywork Traverse City" description="Book your therapeutic massage session with Nikki Leonardi in Traverse City, MI. Online scheduling available 24/7.">
  <div class="pt-16">
    <section class="py-24 px-6 bg-[#1a1714]">
      <div class="max-w-4xl mx-auto">
        <p class="section-label mb-6">Booking</p>
        <h1 class="font-['Playfair_Display'] text-5xl text-[#f5f0e8] mb-6 leading-tight">
          Ready to book?<br/><em class="text-[#c4a882]">Let's get you scheduled.</em>
        </h1>
        <p class="text-[#c4a882]/60 max-w-lg leading-relaxed mb-12">
          Select the session type and length that fits your goals. Not sure where to start? A 90-minute session gives enough time to assess and fully address your pattern.
        </p>

        <!-- Acuity Scheduling embed -->
        <div class="border border-[#c4a882]/20 bg-[#100e0c]">
          <iframe src="https://app.acuityscheduling.com/schedule.php?owner=38952971&ref=embedded_csp" title="Schedule Appointment" width="100%" height="800" frameBorder="0" allow="payment"></iframe>
          <script src="https://embed.acuityscheduling.com/js/embed.js" type="text/javascript"></script>
        </div>

        <!-- Location & contact -->
        <div class="grid md:grid-cols-3 gap-6 mt-12">
          <div class="border border-white/10 p-6">
            <p class="section-label mb-3">Location</p>
            <p class="text-[#c4a882]/70 text-sm">10691 E Carter Rd</p>
            <p class="text-[#c4a882]/70 text-sm">Traverse City, MI 49684</p>
            <a href="https://maps.google.com/maps?q=10691+East+Carter+Road,+Traverse+City,+MI" target="_blank" rel="noopener" class="text-[#c4a882] text-xs tracking-widest uppercase mt-3 block hover:text-[#d4bc9a]">Get Directions →</a>
          </div>
          <div class="border border-white/10 p-6">
            <p class="section-label mb-3">Phone</p>
            <a href="tel:2315905566" class="text-[#c4a882]/70 text-sm hover:text-[#c4a882] transition-colors">231-590-5566</a>
          </div>
          <div class="border border-white/10 p-6">
            <p class="section-label mb-3">Gift Cards</p>
            <p class="text-[#c4a882]/70 text-sm mb-3">Give the work. Available for any session type or dollar amount.</p>
            <a href="#" class="text-[#c4a882] text-xs tracking-widest uppercase hover:text-[#d4bc9a]">Buy a Gift Card →</a>
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>
