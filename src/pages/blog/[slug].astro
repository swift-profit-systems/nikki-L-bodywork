---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.data.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout title={`${post.data.title} | Nikki Leonardi Bodywork`} description={post.data.excerpt}>
  <div class="pt-16">

    <!-- Hero -->
    <section class="py-20 px-6 bg-[#162040]">
      <div class="max-w-3xl mx-auto">
        <a href="/blog" class="text-[#c8a84b]/50 text-xs tracking-widest uppercase hover:text-[#c8a84b] mb-10 block transition-colors">← Back to Blog</a>
        <p class="section-label mb-4">{new Date(post.data.date).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</p>
        <h1 class="font-['Playfair_Display'] text-4xl md:text-5xl text-[#f0f4ff] leading-tight mb-8">{post.data.title}</h1>
        <div class="gold-line"></div>
      </div>
    </section>

    <!-- Content -->
    <section class="py-16 px-6 bg-[#0d1428]">
      <div class="max-w-3xl mx-auto blog-content">
        <Content />
      </div>

      <!-- CTA after article -->
      <div class="max-w-3xl mx-auto mt-16 border-t border-white/10 pt-10 flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
        <div>
          <p class="font-['Playfair_Display'] text-xl text-[#f0f4ff] mb-1">Ready to experience the work?</p>
          <p class="text-[#c8a84b]/50 text-sm">Traverse City, MI · Online booking</p>
        </div>
        <a href="/book" class="btn-primary shrink-0">Book a Session</a>
      </div>
    </section>

    <!-- Related offer -->
    <section class="py-16 px-6 bg-[#162040]">
      <div class="max-w-3xl mx-auto">
        <p class="section-label mb-8">Featured Session</p>
        <div class="border border-[#c8a84b]/20 p-8 flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
          <div>
            <h3 class="font-['Playfair_Display'] text-2xl text-[#f0f4ff] mb-2">120-Min Ashiatsu Session</h3>
            <p class="text-[#c8a84b]/60 text-sm leading-relaxed max-w-md">Full-body barefoot massage. No rushing, no compromise. The deepest work available in Traverse City — given the time to do it right.</p>
          </div>
          <div class="shrink-0 text-right">
            <p class="font-['Playfair_Display'] text-3xl text-[#c8a84b] mb-3">$200</p>
            <a href="/book" class="btn-primary block">Book Now</a>
          </div>
        </div>
      </div>
    </section>

  </div>
</Layout>

<style is:global>
  .blog-content {
    color: rgb(196 168 130 / 0.75);
    line-height: 1.8;
    font-size: 1.0625rem;
  }
  .blog-content h1,
  .blog-content h2,
  .blog-content h3 {
    font-family: 'Playfair Display', serif;
    color: #f0f4ff;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    line-height: 1.25;
  }
  .blog-content h1 { font-size: 2rem; }
  .blog-content h2 { font-size: 1.5rem; }
  .blog-content h3 { font-size: 1.2rem; }
  .blog-content p {
    margin-bottom: 1.5rem;
  }
  .blog-content ul,
  .blog-content ol {
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
  }
  .blog-content li {
    margin-bottom: 0.5rem;
    padding-left: 0.5rem;
  }
  .blog-content ul li { list-style-type: disc; }
  .blog-content ol li { list-style-type: decimal; }
  .blog-content a {
    color: #c8a84b;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .blog-content a:hover { color: #d4bc9a; }
  .blog-content strong { color: #f0f4ff; font-weight: 600; }
  .blog-content em { color: #f0f4ff; font-style: italic; }
  .blog-content blockquote {
    border-left: 2px solid #c8a84b;
    padding-left: 1.5rem;
    margin: 2rem 0;
    font-style: italic;
    color: #f0f4ff;
    font-family: 'Playfair Display', serif;
    font-size: 1.1rem;
  }
  .blog-content hr {
    border: none;
    border-top: 1px solid rgb(255 255 255 / 0.1);
    margin: 2.5rem 0;
  }
</style>
