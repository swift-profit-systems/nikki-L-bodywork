---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Massage Services | Nikki Leonardi Bodywork Traverse City" description="Ashiatsu barefoot massage, deep tissue, myofascial release, cupping, gua sha, and prenatal massage. Traverse City, MI. Book online.">

  <div class="pt-16">
    <section class="py-24 px-6 bg-[#162040]">
      <div class="max-w-4xl mx-auto text-center">
        <p class="section-label mb-6">Services</p>
        <h1 class="font-['Playfair_Display'] text-5xl text-[#f0f4ff] mb-6 leading-tight">
          Every session is integrative.<br/>
          <em class="text-[#c8a84b]">The modality follows the body.</em>
        </h1>
        <p class="text-[#c8a84b]/60 max-w-xl mx-auto">
          Sessions are booked by time and goal. Nikki draws from all available techniques based on what your body needs that day.
        </p>
      </div>
    </section>

    <!-- Pricing grid -->
    <section class="py-20 px-6 bg-[#0d1428]">
      <div class="max-w-4xl mx-auto">
        <p class="section-label mb-10">Session Rates</p>
        <div class="space-y-px bg-white/5">
          {[
            { length: '60 min', price: '$100', desc: 'Focused work — great for a specific area or maintenance sessions.' },
            { length: '75 min', price: '$125', desc: 'Extended focus. Good when there\'s a primary area plus surrounding patterns.' },
            { length: '90 min', price: '$150', desc: 'The recommended starting point. Enough time to assess and address the full pattern.' },
            { length: '120 min', price: '$200', desc: 'Full-body work without compromise. For complex patterns or full-body overhaul.' },
          ].map(s => (
            <div class="bg-[#0d1428] p-6 md:p-8 flex items-center justify-between hover:bg-[#162040] transition-colors">
              <div>
                <p class="font-['Playfair_Display'] text-xl text-[#f0f4ff]">{s.length} Customized Session</p>
                <p class="text-[#c8a84b]/50 text-sm mt-1">{s.desc}</p>
              </div>
              <div class="text-right ml-8 shrink-0">
                <p class="font-['Playfair_Display'] text-2xl text-[#c8a84b]">{s.price}</p>
                <a href="/book" class="text-[#c8a84b]/40 text-xs tracking-widest uppercase hover:text-[#c8a84b] mt-1 block">Book →</a>
              </div>
            </div>
          ))}
        </div>

        <!-- Prenatal -->
        <div class="mt-10">
          <p class="section-label mb-6">Prenatal Massage</p>
          <div class="space-y-px bg-white/5">
            {[
              { length: '60 min', price: '$100' },
              { length: '90 min', price: '$150' },
            ].map(s => (
              <div class="bg-[#0d1428] p-6 flex items-center justify-between hover:bg-[#162040] transition-colors">
                <p class="font-['Playfair_Display'] text-xl text-[#f0f4ff]">{s.length} Prenatal Massage</p>
                <div class="text-right">
                  <p class="font-['Playfair_Display'] text-2xl text-[#c8a84b]">{s.price}</p>
                  <a href="/book" class="text-[#c8a84b]/40 text-xs tracking-widest uppercase hover:text-[#c8a84b] mt-1 block">Book →</a>
                </div>
              </div>
            ))}
          </div>
          <p class="text-[#c8a84b]/40 text-sm mt-3">All products free from ingredients that could put you or your baby at risk.</p>
        </div>
      </div>
    </section>

    <!-- Service deep dives -->
    <section class="py-20 px-6 bg-[#162040]">
      <div class="max-w-6xl mx-auto">
        <p class="section-label mb-10">Modalities</p>
        <div class="grid md:grid-cols-2 gap-8">
          {[
            {
              name: 'Ashiatsu (Barefoot) Massage',
              tag: 'Signature',
              href: '/services/ashiatsu',
              desc: 'Barefoot massage using overhead support bars. Delivers sustained, consistent pressure that hands cannot replicate. If you\'ve never been able to find "deep enough" — this is it.',
              quote: '"The ashiatsu modality feels like you have 2 people giving you a massage!" — Danielle P.'
            },
            {
              name: 'Deep Tissue',
              tag: null,
              href: '/services/deep-tissue',
              desc: 'Real deep tissue work isn\'t about pushing harder. It\'s about knowing what\'s holding the tension, why it\'s there, and how to address it without fighting the body.',
              quote: '"She is very knowledgeable about the body and the muscle." — Albert P.'
            },
            {
              name: 'Myofascial Release',
              tag: null,
              href: '/services/myofascial',
              desc: 'For tension you can feel but can\'t quite touch. Slow and specific work that addresses the fascial restrictions causing chronic pain and limited movement.',
              quote: '"My favorite is the cupping — it really releases the sticky myofascial connective tissue." — Michelle M.'
            },
            {
              name: 'Cupping Therapy',
              tag: null,
              href: '/services/cupping',
              desc: 'Most bodywork pushes down into tissue. Cupping works the opposite way — lifting and decompressing to create space and draw circulation into restricted areas.',
              quote: '"I have felt mass improvement after this procedure." — Michelle M.'
            },
          ].map(s => (
            <a href={s.href} class="border border-white/10 p-8 hover:border-[#c8a84b]/30 transition-colors group block">
              {s.tag && <span class="section-label text-xs mb-3 block">{s.tag}</span>}
              <h3 class="font-['Playfair_Display'] text-xl text-[#f0f4ff] mb-4 group-hover:text-[#c8a84b] transition-colors">{s.name}</h3>
              <p class="text-[#c8a84b]/60 text-sm leading-relaxed mb-5">{s.desc}</p>
              <p class="text-[#c8a84b]/30 text-xs italic mb-5">{s.quote}</p>
              <p class="text-[#c8a84b] text-xs tracking-widest uppercase">Learn more →</p>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-20 px-6 bg-[#0d1428] text-center">
      <div class="max-w-xl mx-auto">
        <h2 class="font-['Playfair_Display'] text-3xl text-[#f0f4ff] mb-4">Not sure where to start?</h2>
        <p class="text-[#c8a84b]/60 mb-8">Book a 90-min session. Nikki will assess and adapt from there.</p>
        <a href="/book" class="btn-primary">Book a Session</a>
      </div>
    </section>
  </div>
</Layout>
