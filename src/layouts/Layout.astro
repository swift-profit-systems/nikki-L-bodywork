---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  showStickyBook?: boolean;
  isBookPage?: boolean;
}

const {
  title,
  description = "Nikki Leonardi Bodywork. Traverse City's premier therapeutic massage specialist. Ashiatsu barefoot massage, myofascial release, deep tissue, cupping, and gua sha. 13 years. 5.0 stars.",
  ogImage = '/images/studio.webp',
  showStickyBook = false,
  isBookPage = false
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#FFFFFF" />
    <link rel="canonical" href={canonicalURL} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400;1,600&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet" />
    <link rel="preload" as="image" href="/studio-interior.webp" />
  </head>
  <body data-is-book-page={isBookPage ? "true" : "false"}>
    <!-- Nav -->
    <nav class="fixed top-0 left-0 right-0 z-50 bg-white/95 backdrop-blur-sm border-b border-[#E8E0D4] shadow-sm">
      <div class="max-w-6xl mx-auto px-6 flex items-center justify-between h-16">
        <a href="/" class="flex items-center gap-3 hover:opacity-80 transition-opacity duration-200">
          <img src="/images/nikki-logo.webp" alt="Nikki Leonardi Bodywork logo" width="62" height="40" class="h-10 w-auto" />
          <span class="font-['Inter'] text-[#1A1A1A] tracking-wide" style="font-size:0.75rem;letter-spacing:0.04em;line-height:1.2;">Nikki Leonardi Bodywork</span>
        </a>
        <!-- Desktop nav -->
        <div class="hidden md:flex items-center gap-8">
          <a href="/" class="text-[#1A1A1A] hover:text-[#C8952E] tracking-widest uppercase transition-colors duration-200 text-sm font-medium">Home</a>
          <a href="/about" class="text-[#1A1A1A] hover:text-[#C8952E] tracking-widest uppercase transition-colors duration-200 text-sm font-medium">Meet Nikki</a>
          <a href="/tools" class="text-[#1A1A1A] hover:text-[#C8952E] tracking-widest uppercase transition-colors duration-200 text-sm font-medium">Tools of the Trade</a>
          <a href="/book" class="btn-primary ml-4">Book a Session</a>
        </div>
        <!-- Mobile menu button -->
        <button id="menu-toggle" class="md:hidden text-[#1A1A1A] cursor-pointer" aria-label="Open menu">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
            <path d="M3 6h18M3 12h18M3 18h18"/>
          </svg>
        </button>
      </div>
      <!-- Mobile menu -->
      <div id="mobile-menu" class="hidden md:hidden bg-white border-t border-[#E8E0D4] px-6 py-6 flex flex-col gap-5">
        <a href="/" class="text-[#1A1A1A] hover:text-[#C8952E] uppercase tracking-widest transition-colors duration-200 text-sm font-medium">Home</a>
        <a href="/about" class="text-[#1A1A1A] hover:text-[#C8952E] uppercase tracking-widest transition-colors duration-200 text-sm font-medium">Meet Nikki</a>
        <a href="/tools" class="text-[#1A1A1A] hover:text-[#C8952E] uppercase tracking-widest transition-colors duration-200 text-sm font-medium">Tools of the Trade</a>
        <a href="/book" class="btn-primary w-full text-center mt-2">Book a Session</a>
      </div>
    </nav>

    <main>
      <slot />
    </main>

    <!-- Footer -->
    <footer id="site-footer" class="bg-[#0d1428] border-t border-white/5 py-16 px-6">
      <div class="max-w-6xl mx-auto grid md:grid-cols-3 gap-12">
        <div>
          <img src="/images/nikki-logo.webp" alt="Nikki Leonardi Bodywork logo" width="99" height="64" class="h-16 w-auto mb-3" />
          <p class="text-[#c8a84b]/80 text-sm leading-relaxed">Therapeutic massage for people who take their body seriously.</p>
          <p class="text-[#c8a84b]/60 text-xs mt-4">Traverse City, MI</p>
        </div>
        <div>
          <p class="section-label mb-5">Navigate</p>
          <div class="flex flex-col gap-3">
            <a href="/" class="text-[#c8a84b]/80 hover:text-[#c8a84b] text-sm transition-colors duration-200">Home</a>
            <a href="/about" class="text-[#c8a84b]/80 hover:text-[#c8a84b] text-sm transition-colors duration-200">Meet Nikki</a>
            <a href="/tools" class="text-[#c8a84b]/80 hover:text-[#c8a84b] text-sm transition-colors duration-200">Tools of the Trade</a>
            <a href="/book" class="text-[#c8a84b]/80 hover:text-[#c8a84b] text-sm transition-colors duration-200">Book</a>
          </div>
        </div>
        <div>
          <p class="section-label mb-5">Find Me</p>
          <p class="text-[#c8a84b]/80 text-sm mb-2">10691 E Carter Rd</p>
          <p class="text-[#c8a84b]/80 text-sm mb-5">Traverse City, MI 49684</p>
          <a href="tel:2315905566" class="text-[#c8a84b]/80 hover:text-[#c8a84b] text-sm transition-colors duration-200 block mb-2">231-590-5566</a>
          <a href="/book" class="btn-primary mt-6 block text-center">Book a Session</a>
        </div>
      </div>
      <div class="max-w-6xl mx-auto mt-12 pt-8 border-t border-white/5 text-center">
        <p class="text-[#c8a84b]/40 text-xs">© 2026 Nikki Leonardi Bodywork. All rights reserved.</p>
      </div>
    </footer>

    <!-- Sticky mobile Book button -->
    {showStickyBook && (
      <div
        id="sticky-book-btn"
        class="fixed bottom-0 left-0 right-0 z-40 md:hidden px-4 pb-4 pt-2 opacity-0 pointer-events-none transition-opacity duration-300"
        style="box-shadow: 0 -4px 20px rgba(0,0,0,0.4);"
      >
        <a href="/book" class="block w-full text-center bg-[#C8952E] text-white font-semibold py-4 tracking-widest uppercase text-sm rounded-lg shadow-md border-2 border-[#C8952E] hover:bg-[#B8850E] hover:border-[#B8850E] transition-colors duration-200">
          Book a Session
        </a>
      </div>
    )}

    <!-- Mobile menu JS -->
    <script>
      const toggle = document.getElementById('menu-toggle');
      const menu = document.getElementById('mobile-menu');
      toggle?.addEventListener('click', () => menu?.classList.toggle('hidden'));
    </script>

    <!-- Sticky book button JS -->
    {showStickyBook && (
      <script>
        (function() {
          const stickyBtn = document.getElementById('sticky-book-btn');
          const footer = document.getElementById('site-footer');
          if (!stickyBtn || !footer) return;
          let footerVisible = false;
          const obs = new IntersectionObserver((entries) => {
            entries.forEach(e => { footerVisible = e.isIntersecting; update(); });
          });
          obs.observe(footer);
          function update() {
            if (window.scrollY > 300 && !footerVisible) {
              stickyBtn.classList.remove('opacity-0', 'pointer-events-none');
              stickyBtn.classList.add('opacity-100');
            } else {
              stickyBtn.classList.add('opacity-0', 'pointer-events-none');
              stickyBtn.classList.remove('opacity-100');
            }
          }
          window.addEventListener('scroll', update, { passive: true });
        })();
      </script>
    )}

  </body>
</html>
