---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const {
  title,
  description = "Nikki Leonardi Bodywork — Traverse City's premier therapeutic massage specialist. Ashiatsu barefoot massage, myofascial release, deep tissue, cupping, and gua sha. 13 years. 5.0 stars.",
  ogImage = '/images/studio.png'
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#162040" />
    <link rel="canonical" href={canonicalURL} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <!-- Nav -->
    <nav class="fixed top-0 left-0 right-0 z-50 bg-[#162040]/95 backdrop-blur-sm border-b border-white/5">
      <div class="max-w-6xl mx-auto px-6 flex items-center justify-between h-16">
        <a href="/" class="flex items-center hover:opacity-80 transition-opacity">
          <img src="/images/nikki-logo.png" alt="Nikki Leonardi Bodywork" class="h-10 w-auto" />
        </a>
        <!-- Desktop nav -->
        <div class="hidden md:flex items-center gap-8">
          <a href="/" class="text-sm text-[#c8a84b]/80 hover:text-[#c8a84b] tracking-widest uppercase" style="font-size:0.7rem;letter-spacing:0.15em;">Home</a>
          <a href="/about" class="text-sm text-[#c8a84b]/80 hover:text-[#c8a84b] tracking-widest uppercase" style="font-size:0.7rem;letter-spacing:0.15em;">Meet Nikki</a>
          <a href="/tools" class="text-sm text-[#c8a84b]/80 hover:text-[#c8a84b] tracking-widest uppercase" style="font-size:0.7rem;letter-spacing:0.15em;">Tools of the Trade</a>
          <a href="/book" class="btn-primary ml-4">Book a Session</a>
        </div>
        <!-- Mobile menu button -->
        <button id="menu-toggle" class="md:hidden text-[#c8a84b]" aria-label="Open menu">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
            <path d="M3 6h18M3 12h18M3 18h18"/>
          </svg>
        </button>
      </div>
      <!-- Mobile menu -->
      <div id="mobile-menu" class="hidden md:hidden bg-[#162040] border-t border-white/5 px-6 py-6 flex flex-col gap-5">
        <a href="/" class="text-[#c8a84b]/80 hover:text-[#c8a84b] uppercase tracking-widest" style="font-size:0.75rem;">Home</a>
        <a href="/about" class="text-[#c8a84b]/80 hover:text-[#c8a84b] uppercase tracking-widest" style="font-size:0.75rem;">Meet Nikki</a>
        <a href="/tools" class="text-[#c8a84b]/80 hover:text-[#c8a84b] uppercase tracking-widest" style="font-size:0.75rem;">Tools of the Trade</a>
        <a href="/book" class="btn-primary w-full text-center mt-2">Book a Session</a>
      </div>
    </nav>

    <main>
      <slot />
    </main>

    <!-- Footer -->
    <footer class="bg-[#0d1428] border-t border-white/5 py-16 px-6">
      <div class="max-w-6xl mx-auto grid md:grid-cols-3 gap-12">
        <div>
          <img src="/images/nikki-logo.png" alt="Nikki Leonardi Bodywork" class="h-16 w-auto mb-3" />
          <p class="text-[#c8a84b]/60 text-sm leading-relaxed">Therapeutic massage for people who take their body seriously.</p>
          <p class="text-[#c8a84b]/40 text-xs mt-4">Traverse City, MI</p>
        </div>
        <div>
          <p class="section-label mb-5">Navigate</p>
          <div class="flex flex-col gap-3">
            <a href="/" class="text-[#c8a84b]/60 hover:text-[#c8a84b] text-sm transition-colors">Home</a>
            <a href="/about" class="text-[#c8a84b]/60 hover:text-[#c8a84b] text-sm transition-colors">Meet Nikki</a>
            <a href="/tools" class="text-[#c8a84b]/60 hover:text-[#c8a84b] text-sm transition-colors">Tools of the Trade</a>
            <a href="/book" class="text-[#c8a84b]/60 hover:text-[#c8a84b] text-sm transition-colors">Book</a>
          </div>
        </div>
        <div>
          <p class="section-label mb-5">Find Me</p>
          <p class="text-[#c8a84b]/60 text-sm mb-2">10691 E Carter Rd</p>
          <p class="text-[#c8a84b]/60 text-sm mb-5">Traverse City, MI 49684</p>
          <a href="tel:2315905566" class="text-[#c8a84b]/60 hover:text-[#c8a84b] text-sm transition-colors block mb-2">231-590-5566</a>
          <a href="/book" class="btn-primary mt-6 block text-center">Book a Session</a>
        </div>
      </div>
      <div class="max-w-6xl mx-auto mt-12 pt-8 border-t border-white/5 text-center">
        <p class="text-[#c8a84b]/30 text-xs">© 2026 Nikki Leonardi Bodywork. All rights reserved.</p>
      </div>
    </footer>

    <!-- Mobile menu JS -->
    <script>
      const toggle = document.getElementById('menu-toggle');
      const menu = document.getElementById('mobile-menu');
      toggle?.addEventListener('click', () => menu?.classList.toggle('hidden'));
    </script>

    <!-- Sticky mobile book button -->
    <div class="fixed bottom-0 left-0 right-0 md:hidden z-50 p-4 bg-[#162040]/95 backdrop-blur-sm border-t border-white/10">
      <a href="/book" class="btn-primary w-full text-center block">Book a Session</a>
    </div>
  </body>
</html>
